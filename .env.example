# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored. Never commit it.

# ---- Browserbase (required) ----
# Free key from https://browserbase.com/settings
# This one key runs the cloud browser AND the AI (via Model Gateway).
BROWSERBASE_API_KEY=bb_live_your_key_here

# ---- Your greytHR portal (required) ----
# Just your company's greytHR subdomain. If you log in at
# https://acme.greythr.com/v3/portal/ then this is "acme".
GREYTHR_SUBDOMAIN=your-company

# Only needed if your portal lives somewhere non-standard — this overrides
# GREYTHR_SUBDOMAIN entirely.
# GREYTHR_URL=https://your-company.greythr.com/v3/portal/

# ---- Your greytHR login (required) ----
GREYTHR_USERNAME=your-employee-number-or-email
GREYTHR_PASSWORD=your-greythr-password

# ---- Days off ----
# Days to sit out: single dates, ranges, or PAUSE to stop entirely.
# Easiest set with:  npm run skip -- tomorrow
# SKIP_DATES=2026-10-02,2026-12-24..2026-12-31

# Timezone used to decide which day it is (not the runner's UTC).
# SCHEDULE_TZ=Asia/Kolkata

# ---- Optional ----
# Default mode if you don't pass one on the command line (signin | signout)
MODE=signin

# Most tenants label the attendance toggle "Sign In" / "Sign Out". If yours
# says something else — "Clock In", "Punch In", "Swipe In" — set it here.
# GREYTHR_SIGNIN_LABEL=Sign In
# GREYTHR_SIGNOUT_LABEL=Sign Out

# Browserbase needs a project id to open a session, but the script looks it up
# from your API key automatically. Only set this to skip that lookup, or to
# pin one project if your account has several.
# BROWSERBASE_PROJECT_ID=

# Leave STAGEHAND_MODEL unset and Browserbase's Model Gateway picks a model for
# you, billed to your Browserbase key — no OpenAI/Anthropic/Google key needed.
# Set it only to pin a specific model.
# STAGEHAND_MODEL=google/gemini-2.5-flash

# Do NOT set provider keys (OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, …).
# A placeholder value makes Stagehand try to use it and fail with a misleading
# "API key not valid".
